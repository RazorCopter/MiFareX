<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight" />

    <!-- Theme for ComposeActivity — no ActionBar, Compose handles everything -->
    <style name="ComposeTheme" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Splash screen theme using core-splashscreen API -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <!-- Background color shown behind the icon -->
        <item name="windowSplashScreenBackground">#0D1B2A</item>
        <!-- The launch icon shown centred on splash -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <!-- Post-splash theme applied by installSplashScreen() -->
        <item name="postSplashScreenTheme">@style/ComposeTheme</item>
    </style>
</resources>
